# Local development: empty DATABASE_URL uses instance/shopflow.db
APP_ENV=development
# Generate a random secret; required (32+ characters) for production.
SECRET_KEY=
# PostgreSQL: postgresql+psycopg://user:password@localhost:5432/shopflow
DATABASE_URL=
BASE_URL=http://127.0.0.1:5000
# Test keys only. Missing key or webhook secret enables the labeled mock checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional; leave both empty to skip Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
